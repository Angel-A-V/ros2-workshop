<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>workshop_demos</name>
  <version>0.1.0</version>
  <description>Robotics Society workshop demos (turtlesim and RViz). No robot hardware needed.</description>
  <maintainer email="robotics@todo.todo">Robotics Society at UC Merced</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>dummy_robot_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
